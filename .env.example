# Supabase (optional — without it the app serves the bundled, verified seed dataset)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Daily pipeline
ANTHROPIC_API_KEY=
CRON_SECRET=

# Optional: venue review counts (Google Places API "New", Text Search)
GOOGLE_PLACES_API_KEY=

# Optional: Instagram feeders (Instagram Graph API Business Discovery). Your own Instagram
# Business/Creator account id and a long-lived token with instagram_basic access.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Optional: Reddit feeders (official API, application-only OAuth). Create a "script"/"web" app
# at https://www.reddit.com/prefs/apps and copy its id and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
